[Unit]
Description=Apex 7 TKL control daemon (RGB, OLED, wheel)
After=graphical-session.target
PartOf=graphical-session.target
# If the daemon cannot start (stale socket, missing device), fail visibly
# instead of restarting forever.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/apexctl daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
