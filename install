#!/bin/bash
# Install apexctl onto PATH, enable the user daemon, and register Omarchy hooks.
# Idempotent and cheap when nothing changed: the bar widget runs this on first
# load, so it must not fork systemctl every time the plugin reloads.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/bin/apexctl"
UNIT_SRC="$SCRIPT_DIR/systemd/apexctl.service"
UNIT_DEST="$HOME/.config/systemd/user/apexctl.service"
STAMP_DIR="$HOME/.local/state/apex"
STAMP="$STAMP_DIR/install.stamp"
SILENT=0
[[ "${1:-}" == "--silent" ]] && SILENT=1

say() { (( SILENT )) || echo "$*"; }

link_cli() {
  local dir="$1"
  mkdir -p "$dir" 2>/dev/null || return 1
  local target="$dir/apexctl"
  if [[ -L $target ]]; then
    [[ "$(readlink -f "$target")" == "$(readlink -f "$BIN")" ]] && return 0
    rm -f "$target"
  elif [[ -e $target ]]; then
    [[ -e $target.bak ]] || mv "$target" "$target.bak"
  fi
  ln -s "$BIN" "$target"
}

install_unit() {
  mkdir -p "$HOME/.config/systemd/user"
  if [[ -e $UNIT_DEST ]] && ! cmp -s "$UNIT_SRC" "$UNIT_DEST"; then
    # Keep the user's copy once, then install ours — the widget must not lose
    # local hardening (restart limits, environment) silently.
    [[ -e $UNIT_DEST.bak ]] || cp "$UNIT_DEST" "$UNIT_DEST.bak"
  fi
  cp "$UNIT_SRC" "$UNIT_DEST"
  systemctl --user daemon-reload
  systemctl --user enable --now apexctl.service >/dev/null
}

install_hooks() {
  command -v omarchy >/dev/null || return 0
  omarchy hook install theme-set "$SCRIPT_DIR/hooks/apply-keyboard-rgb" >/dev/null
  omarchy hook install post-boot "$SCRIPT_DIR/hooks/apexctl" >/dev/null
}

wanted_stamp() {
  local version
  version="$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$SCRIPT_DIR/manifest.json" | head -1)"
  echo "${version:-0} $(sha256sum "$UNIT_SRC" | cut -d' ' -f1)"
}

CURRENT="$(cat "$STAMP" 2>/dev/null || true)"
WANTED="$(wanted_stamp)"

if [[ ! -x $BIN ]]; then
  chmod +x "$BIN" "$SCRIPT_DIR/bin/apex/"*.py 2>/dev/null || true
  chmod +x "$BIN"
fi

if ! link_cli "$HOME/.local/bin"; then
  echo "Could not write $HOME/.local/bin/apexctl" >&2
  exit 1
fi

if [[ $CURRENT == "$WANTED" ]]; then
  # Nothing to do; the symlink and the daemon are already in place.
  (( SILENT )) || echo "apexctl already installed (${WANTED%% *})"
  exit 0
fi

install_unit
say "Enabled systemd --user apexctl.service"
install_hooks
say "Installed theme-set and post-boot hooks"

mkdir -p "$STAMP_DIR"
printf '%s\n' "$WANTED" > "$STAMP"

# Hint if the OLED hidraw is present but not writable.
if ! python3 - "$SCRIPT_DIR" >/dev/null 2>&1 <<'PY'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[1], "bin"))
from apex.oled import find_oled_hidraw
path = find_oled_hidraw()
sys.exit(0 if path and os.access(path, os.W_OK) else 1)
PY
then
  say "OLED hidraw is not writable yet. Install udev rules:"
  say "  sudo cp $SCRIPT_DIR/udev/99-steelseries-apex.rules /etc/udev/rules.d/"
  say "  sudo udevadm control --reload && sudo udevadm trigger"
fi

exit 0
